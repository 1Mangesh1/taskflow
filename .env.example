NODE_ENV=development
PORT=3000
# Host-facing values, for npm run dev and the test suite: postgres and redis publish on
# the loopback interface. docker compose overrides both with the service names, because
# one container cannot reach another through the host's loopback:
#   DATABASE_URL=postgresql://taskflow:taskflow@postgres:5432/taskflow
#   REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow
REDIS_URL=redis://localhost:6379
# No default on purpose: an empty value fails config validation, so a checkout cannot
# boot on a secret published in this repo. openssl rand -hex 32
JWT_SECRET=
TEST_DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow_test
TEST_REDIS_URL=redis://localhost:6379/1
# Serves the OpenAPI document at /docs/json and Swagger UI at /docs.
DOCS_ENABLED=true

# Comma-separated browser origins allowed to call the API cross-origin. Empty means
# same-origin only. Set this to your GitHub Pages origin if you host the console there:
#   CORS_ORIGINS=https://<user>.github.io
CORS_ORIGINS=
